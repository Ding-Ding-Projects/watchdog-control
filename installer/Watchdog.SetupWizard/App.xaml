<Application x:Class="Watchdog.SetupWizard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="Cyan" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="WindowBackground" Color="#F7F8FC" />
            <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextPrimary" Color="#171B24" />
            <SolidColorBrush x:Key="TextSecondary" Color="#5E6675" />
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="Margin" Value="4" />
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Margin" Value="0,6,0,14" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
