<Window x:Class="Watchdog.SetupWizard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Watchdog Control Setup" Width="1180" Height="780" MinWidth="640" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="{StaticResource WindowBackground}"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" SizeChanged="Window_SizeChanged">
    <Border BorderBrush="#D9DEE8" BorderThickness="1" CornerRadius="18" Background="{StaticResource WindowBackground}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#EEF2F9" CornerRadius="18,18,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="9" Background="#2458D3" Margin="0,0,10,0">
                            <TextBlock Text="W" Foreground="White" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="WATCHDOG CONTROL" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="  •  SETUP ASSISTANT" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Minimize" AutomationProperties.Name="Minimize window" Click="Minimize_Click" Content="—"/>
                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore window" Click="Maximize_Click" Content="□"/>
                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Close" AutomationProperties.Name="Close setup assistant" Click="Close_Click" Content="×"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="26,24,26,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="NavigationPanel" Grid.Column="0" CornerRadius="18" Background="{StaticResource SurfaceBackground}" Padding="20">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="2,4,2,22">
                            <TextBlock Text="Setup progress" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="StepCounter" Text="STEP 1 OF 6" FontSize="12" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="StepList"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="2,20,2,2">
                            <Border Height="1" Background="#E5E9F0" Margin="0,0,0,14"/>
                            <TextBlock Text="Your configuration is saved on this computer. Credentials are never written to the setup record or operation log." FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="VersionText" Text="Version and build time: unavailable" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border x:Name="ContentPanel" Grid.Column="2" CornerRadius="18" Background="{StaticResource SurfaceBackground}" Padding="34,30,34,22">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock x:Name="CompactStepText" Grid.Row="0" Text="STEP 1 OF 6" FontSize="12" FontWeight="Bold" Margin="2,0,0,8" Visibility="Collapsed"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel x:Name="PageHost"/>
                        </ScrollViewer>
                        <Border Grid.Row="2" Background="#F3F6FB" CornerRadius="12" Padding="14,11" Margin="0,15,0,14" AutomationProperties.LiveSetting="Polite">
                            <DockPanel>
                                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#677184" Margin="0,4,10,0" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="StatusText" Text="Ready. No changes have been made." FontSize="13" Foreground="{StaticResource TextSecondary}" AutomationProperties.LiveSetting="Polite"/>
                            </DockPanel>
                        </Border>
                        <DockPanel Grid.Row="3">
                            <Button x:Name="BackButton" Content="Back" Click="Back_Click" HorizontalAlignment="Left" IsEnabled="False"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                <Button x:Name="NextButton" Content="Next" Click="Next_Click" IsDefault="True"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
