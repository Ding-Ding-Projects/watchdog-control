{
  "name": "watchdog-control-setup",
  "version": "0.3.0",
  "private": true,
  "description": "Portable setup assistant for Watchdog Control",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "build": "node scripts/write-build-provenance.mjs && vite build",
    "package:portable": "electron-builder --win portable --x64 --publish never",
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.dingdingprojects.watchdogcontrol.setup",
    "productName": "Watchdog Control Setup",
    "asar": true,
    "directories": {
      "output": "../../artifacts/electron-setup"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "hosting/**/*.cjs",
      "!hosting/**/*.test.cjs",
      "build-provenance.json",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "../../artifacts/controller", "to": "controller", "filter": ["**/*", "!**/*.pdb"] },
      { "from": "../../artifacts/tools", "to": "tools", "filter": ["node.exe", "cloudflared.exe"] }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WatchdogControlSetup.exe"
    },
    "portable": {
      "artifactName": "WatchdogControlSetup.exe"
    }
  }
}
