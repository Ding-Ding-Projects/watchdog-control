# Copy this file to .env, replace every value, and keep .env out of source control.
WATCHDOG_IMAGE=ghcr.io/ding-ding-projects/watchdog-control@sha256:replace-with-release-digest
WATCHDOG_HOST_PORT=8443
# Replace this example with an active private IPv4 address on the hosting computer.
WATCHDOG_HOST_BIND_IP=192.168.1.20
WATCHDOG_DATA_PATH=C:/ProgramData/WatchdogControl/data
WATCHDOG_TLS_CERTIFICATE_HOST_FILE=C:/ProgramData/WatchdogControl/secrets/watchdog_tls_certificate.pfx
WATCHDOG_TLS_PASSWORD_HOST_FILE=C:/ProgramData/WatchdogControl/secrets/watchdog_tls_password
WATCHDOG_PAIRING_CODE_HOST_FILE=C:/ProgramData/WatchdogControl/secrets/watchdog_pairing_code
WATCHDOG_AGENT_ENROLLMENT_CODE_HOST_FILE=C:/ProgramData/WatchdogControl/secrets/watchdog_agent_enrollment_code
